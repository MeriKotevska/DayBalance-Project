# ──────────────────────────────────────────────
# DayBalance — environment variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ──────────────────────────────────────────────

# MongoDB connection string.
# Local development (Docker or a local MongoDB instance):
MONGODB_URI=mongodb://localhost:27017/daybalance
# Production (MongoDB Atlas or another cloud provider):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/daybalance?retryWrites=true&w=majority

# Port the Express server listens on.
PORT=3000

# Environment name: development | production
NODE_ENV=development
